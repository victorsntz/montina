{
  "name": "cartilha-lupus-df",
  "version": "0.1.0",
  "private": true,
  "description": "Manual para o paciente com lúpus do Distrito Federal — diagramação A4 (impressa) e versão web",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pdf": "node scripts/pdf.mjs && /usr/bin/python3 scripts/marcadores.py",
    "pdf:grafica": "node scripts/pdf.mjs print-grafica.html cartilha-lupus-df-a4-grafica-sangria3mm.pdf && npm run cmyk",
    "memorial": "node scripts/memorial.mjs && node scripts/pdf.mjs memorial.html memorial-projeto-grafico.pdf",
    "cmyk": "gs -q -dNOPAUSE -dBATCH -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress -sColorConversionStrategy=CMYK -dProcessColorModel=/DeviceCMYK -dEmbedAllFonts=true -dSubsetFonts=true -dCompatibilityLevel=1.4 -sOutputFile=dist/cartilha-lupus-df-a4-grafica-sangria3mm-cmyk.pdf dist/cartilha-lupus-df-a4-grafica-sangria3mm.pdf",
    "preview": "node scripts/preview.mjs",
    "livreto": "node scripts/pdf.mjs print-grafica.html cartilha-lupus-df-a4-grafica-sangria3mm.pdf && /usr/bin/python3 scripts/livreto.py && /usr/bin/python3 scripts/spreads.py"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "pagedjs": "^0.4.3",
    "playwright-core": "^1.56.1"
  }
}
